# MinerU 服务环境变量（由 install.sh 生成，权限 600，root 拥有）
# 运行期零外网依赖：模型来源固定 local，并关闭 HF/Transformers 联网探测
MINERU_MODEL_SOURCE=local
MINERU_TELEMETRY_DISABLED=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# bearer 模式下由 /etc/mineru/mineru-start.sh 展开为 --api-key；
# anonymous 模式保留为空，包装脚本不会传该参数。
MINERU_API_KEY=__API_KEY__
