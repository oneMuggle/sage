# ====================
# Sage .gitignore
# ====================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.venv/
venv/
ENV/
env/
.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Rust / Cargo
target/
# 注: Cargo.lock 必须 commit (应用程序, 非库)
# - CI 用 --locked 严格按此 lock 编译
# - Tauri 2.1.1 + Win7 + Rust 1.77.2 依赖图脆弱, lock 是唯一锚点

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3
data/
# Re-include backend/data/ (Python module package) but still ignore
# runtime SQLite files. The bare `data/` rule would otherwise shadow
# `backend/data/*.py` for anyone adding a new repo module.
!backend/data/
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
# Runtime audit/JSONL ledgers written under backend/data/. These are
# created by the runtime, not part of the source tree.
backend/data/audit/*.jsonl
# Arena automation runtime state: Fernet master key + SQLite WAL/SHM sidecars
# (docs/mcp-aren-card-port-plan.md §10 — the master key must never be committed;
# `backend/data/*.sqlite` above covers the DB file but not -wal/-shm).
backend/data/arena/
# Arena job exports (registration results media/downloads), runtime-generated.
backend/data/media/
# Local arena spike/probe/smoke evidence (S0, P1, ...), not part of the source tree.
.tmp-arena-*/

# ── 本地会话/过程产物（2026-09-22 housekeeping：多会话并行开发遗留）──────
# 会话级工具目录与状态文件——运行期产物，不属于源码
.zcode/
.tmp-auth-device/
.tmp-audit/
.arena_q.tmp
recent.json
logs/
# Windows `> nul` 重定向误产物（0 字节）
nul
# 轮次 PR/commit message 草稿与过程 plan（内容已随对应 PR 落库）
r[0-9]*-msg.txt
.r*-plan-draft.md
.r*-pr-body.md

# Environment
.env
.env.local
.env.*.local

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Test
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Test coverage reports
coverage/
.coverage
# Stray parallel-mode coverage data files (pytest-xdist). Without this rule
# the backend directory accumulates dozens of `.coverage.g-X1C.pid<NNNN>.*`
# untracked files after every local pytest run. The base `.coverage` rule
# above only matches the single combined-data file; pytest-xdist writes one
# per worker using the `.<basename>.<host>.<pid>.<random>` pattern.
.coverage.*
!backend/data/.coverage.*

# Claude Code local config (per-developer)
.claude/

# Playwright MCP
.playwright-mcp/

# Electron builder
dist-electron/
release/
# Allow scripts/release/ (Sage tier inference + changelog tooling)
!scripts/release/

# Playwright
.playwright/
test-results/
playwright-report/
tests/electron/screenshots/

# VCRedist runtime bundled at build time (fetched by scripts/fetch-vcredist.ps1)
resources/vc_redist.x64.exe

# Build artifacts and release packages
release-artifacts/

# Reference files with sensitive credentials (API keys, tokens)
reference/

# Temporary screenshots
chat-*.png

# MCP Server build artifacts
packages/drawio-mcp-server/node_modules/
packages/drawio-mcp-server/dist/

# §1.3c 仓库卫生
桌面/
Desktop/

# 编排子任务隔离目录（运行时产物）
data/orch_scratch/

# Git worktrees (隔离开发目录)
.worktrees/

# SDD workspace (scratch for subagent-driven-development)
.superpowers/

# 本地调试草稿与崩溃转储（不进仓库）
backend/_diag*.py
backend/_diag*.txt
*.stackdump
ci*.log
r[0-9]*-*.log

# 本地 CI 复现用虚拟环境
.venv-ci/
