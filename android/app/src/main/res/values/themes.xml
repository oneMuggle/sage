<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 现代安卓 MD3：DayNight 自动深浅，NoActionBar 配合 Toolbar -->
    <style name="Theme.ArenaCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <!-- 系统栏颜色与图标深浅由 EdgeToEdgeInsets.install()（enableEdgeToEdge）在运行时统一设置，
             刘海 / 状态栏 / 导航栏 / 输入法的避让由 EdgeToEdgeInsets.apply() 逐页施加。
             这里不再声明 statusBarColor / windowLightStatusBar：targetSdk 35 起前者被忽略，
             后者写死为 true 会在深色模式下把图标刷反。 -->
    </style>

    <!-- 设置页等表单类页面的复用样式：与 item_instance / activity_register 的卡片、输入框视觉一致 -->
    <style name="Widget.Arena.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Arena.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_primary</item>
        <item name="hintTextColor">@color/md_primary</item>
    </style>
    <style name="Widget.Arena.SectionTitle" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>
    <style name="Widget.Arena.HintText" parent="@android:style/Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/md_onSurfaceVariant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Widget.Arena.BodyText" parent="@android:style/Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_onSurface</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
