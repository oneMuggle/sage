<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="设置" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 任务 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Arena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/Widget.Arena.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="任务" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Arena.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="提示词">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/prompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="每步停顿（秒）">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stepPause"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="停顿抖动（秒）">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/jitter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <!-- 运行参数：默认值与桌面端一致（不限轮次 / 300 秒无进展 / 150 秒等模型名）；越界不保存。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="轮次上限（0 = 不限）">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/roundLimit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="无进展上限（秒）">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/noProgress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Arena.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="等待模型名（秒，超时按「未识别」收尾）">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/modelWait"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <!-- 方案要求人机验证一律停下等人工：开关常开且禁用，不给一条能关掉的路径 -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/pauseOnCaptcha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:enabled="false"
                        android:text="遇到人机验证时暂停等待人工"
                        android:textColor="@color/md_onSurface" />
                    <TextView
                        style="@style/Widget.Arena.HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="人机验证一律停下等人工处理，通过后自动续跑、不重发；此项不可关闭。" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 代理 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Arena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/Widget.Arena.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="代理" />
                    <TextView
                        style="@style/Widget.Arena.HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="选了代理后，节点连不上会直接阻止启动，不会退回直连。不支持 Clash 订阅节点。" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/proxyModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:checkedButton="@+id/modeSystem"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeSystem"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="跟随系统" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeHttp"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HTTP / Mixed" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeSocks5"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SOCKS5" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Arena.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="地址（只填 IP 或主机名）"
                        app:helperText="不要带协议、端口、用户名或路径；IPv6 用方括号包裹">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/proxyHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Arena.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="端口（1～65535）">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/proxyPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="用户名（可空）">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/proxyUser"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Arena.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="密码（可空）"
                            app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/proxyPass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 附件 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Arena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/Widget.Arena.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="附件" />
                    <TextView
                        style="@style/Widget.Arena.HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="随每轮提问一起发送。按内容寻址存储，导入后会重新校验哈希；同名附件不能重复。" />
                    <TextView
                        android:id="@+id/attachmentSummary"
                        style="@style/Widget.Arena.BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/attachmentChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        app:chipSpacingVertical="4dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddAttachment"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="添加附件"
                            app:icon="@android:drawable/ic_input_add" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearAttachments"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="移除全部"
                            app:icon="@android:drawable/ic_menu_delete" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCollectGarbage"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="清理无引用的附件文件" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 模型取舍 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Arena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/Widget.Arena.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模型取舍" />
                    <TextView
                        style="@style/Widget.Arena.HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="勾选的模型在本轮结束后会被归档（不保留）。只按完整模型名精确匹配，不做系列或前缀推断；未出现在列表里的模型一律保留。" />
                    <TextView
                        android:id="@+id/retentionSummary"
                        style="@style/Widget.Arena.BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetention"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="选择要归档的模型"
                        app:icon="@android:drawable/ic_menu_agenda" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 账号 · 凭据 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Arena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/Widget.Arena.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="账号 · 凭据" />
                    <TextView
                        style="@style/Widget.Arena.HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="昵称与密码仅在本机加密保存（Android Keystore），用于注册与换号。" />
                    <TextView
                        android:id="@+id/accountSummary"
                        style="@style/Widget.Arena.BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccount"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="设置昵称和密码"
                        app:icon="@android:drawable/ic_menu_myplaces" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- 常驻底栏：长表单里「保存」永远可见，与画廊页底部操作条同构 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E7FFFBFE"
        android:orientation="horizontal"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存"
            app:icon="@android:drawable/ic_menu_save" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
